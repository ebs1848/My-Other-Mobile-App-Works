<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SecondFragment">


    <TextView
        android:id="@+id/textCityName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="city"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        tools:layout_editor_absoluteX="26dp"
        tools:layout_editor_absoluteY="30dp" />

    <TextView
        android:id="@+id/textInfoCity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="infoCity"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        tools:layout_editor_absoluteX="26dp"
        tools:layout_editor_absoluteY="158dp" />

    <TextView
        android:id="@+id/textInfoCity3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Information Of City"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        tools:layout_editor_absoluteX="26dp"
        tools:layout_editor_absoluteY="100dp" />

    <TextView
        android:id="@+id/textInfoCity4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Favorite Food"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        tools:layout_editor_absoluteX="26dp"
        tools:layout_editor_absoluteY="215dp" />

    <TextView
        android:id="@+id/textInfoCity5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Favorite Places"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        tools:layout_editor_absoluteX="26dp"
        tools:layout_editor_absoluteY="329dp" />

    <TextView
        android:id="@+id/textInfoFavFood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fav Food"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        tools:layout_editor_absoluteX="26dp"
        tools:layout_editor_absoluteY="278dp" />

    <TextView
        android:id="@+id/textInfoPlaces"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Places"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        tools:layout_editor_absoluteX="26dp"
        tools:layout_editor_absoluteY="411dp" />

    <Button
        android:id="@+id/button_second"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/previous"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.465"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>